#!/usr/bin/env python3
import sys
import os
import argparse
import glob

# Add the project root to sys.path to allow imports from mingo
sys.path.append(os.path.dirname(os.path.dirname(os.path.abspath(__file__))))

from mingo.coverage import run_coverage_analysis

def main():
    parser = argparse.ArgumentParser(description="Calculate genome coverage from ONT reports and sample sheets.")
    parser.add_argument("csv_path", nargs='?', help="Path to the sample sheet CSV file (optional if --auto is used).")
    
    # Mutually exclusive group for auto-discovery vs manual JSON
    group = parser.add_mutually_exclusive_group()
    group.add_argument("--auto", action="store_true", help="Automatically find inputs in an ONT run directory.")
    group.add_argument("--json", help="Path to the sequencing report JSON file.")
    
    parser.add_argument("--quick", action="store_true", help="Use simplified JSON report coverage instead of full sequencing summary (when using --auto).")
    parser.add_argument("--summary", help="Path to the sequencing summary TXT file.")
    parser.add_argument("--below", type=int, help="Only output lines where coverage is below this value.")
    parser.add_argument("--bin-threshold", type=int, default=7000, help="Read length threshold for binned stats (default: 7000).")
    parser.add_argument("--no-low-material", action="store_true", help="Exclude samples marked as low material in the sample sheet.")
    parser.add_argument("--csv", action="store_true", help="Output in CSV format.")
    
    args = parser.parse_args()
    
    if args.auto:
        cwd_name = os.path.basename(os.getcwd())
        if not (cwd_name.startswith('NSR') or cwd_name.startswith('PSR')):
            print("Error: Current directory does not appear to be an ONT run directory (does not start with 'NSR' or 'PSR').")
            sys.exit(1)
            
        sample_sheets = glob.glob('no_sample_id/*/sample_sheet*.csv')
        reports = glob.glob('no_sample_id/*/report*.json')
        
        if not sample_sheets:
            print("Error: No sample sheet found via 'no_sample_id/*/sample_sheet*.csv'")
            sys.exit(1)
        elif len(sample_sheets) > 1:
            print("Error: Multiple sample sheets found in no_sample_id directory structure. Cannot determine which to use.")
            sys.exit(1)
            
        args.csv_path = sample_sheets[0]
        sheet_dir = os.path.dirname(args.csv_path)
            
        summaries = glob.glob('no_sample_id/*/sequencing_summary*.txt')
        if not summaries:
            summaries = glob.glob('no_sample_id/*/sequencing_summary*.txt.tmp')
            
        reports = glob.glob('no_sample_id/*/report*.json')
        
        if summaries and not args.quick:
            if len(summaries) > 1:
                print("Error: Multiple sequencing summaries found in no_sample_id directory structure. Cannot determine which to use.")
                sys.exit(1)
            args.summary = summaries[0]
            summary_dir = os.path.dirname(args.summary)
            if sheet_dir != summary_dir:
                print(f"Error: Sample sheet and summary are in different subdirectories:\nSheet dir:  {sheet_dir}\nSummary dir: {summary_dir}")
                sys.exit(1)
        else:
            if not reports:
                print("Error: No JSON report found (and no sequencing summary found or --quick specified).")
                sys.exit(1)
            elif len(reports) > 1:
                print("Error: Multiple JSON reports found in no_sample_id directory structure. Cannot determine which to use.")
                sys.exit(1)
            args.json = reports[0]
            report_dir = os.path.dirname(args.json)
            if sheet_dir != report_dir:
                print(f"Error: Sample sheet and report are in different subdirectories:\nSheet dir:  {sheet_dir}\nReport dir: {report_dir}")
                sys.exit(1)
    elif not args.csv_path:
        parser.error("The following arguments are required: csv_path (unless --auto is used)")
    
    if not os.path.exists(args.csv_path):
        print(f"Error: CSV file not found: {args.csv_path}")
        sys.exit(1)
    
    run_coverage_analysis(
        args.csv_path, 
        json_path=args.json, 
        summary_path=args.summary, 
        filter_below_coverage=args.below, 
        output_csv=args.csv, 
        bin_threshold=args.bin_threshold,
        no_low_material=args.no_low_material
    )

if __name__ == "__main__":
    main()
