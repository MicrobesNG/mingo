#!/usr/bin/env python3
import sys
import os
import argparse
import glob
import logging

# Add the project root to sys.path to allow imports from mingo
sys.path.append(os.path.dirname(os.path.dirname(os.path.abspath(__file__))))

import json
from mingo.coverage import run_coverage_analysis, find_coverage_inputs

logging.basicConfig(level=logging.INFO, format='%(asctime)s - %(name)s - %(levelname)s - %(message)s')

def get_minknow_reads_tmp_dir():
    conf_path = '/opt/ont/minknow/conf/user_conf'
    if not os.path.exists(conf_path):
        return None
    try:
        with open(conf_path, 'r') as f:
            data = json.load(f)
        
        output_dirs = data.get('user', {}).get('output_dirs', {})
        base_dir = output_dirs.get('base', {}).get('value0', '/var/lib/minknow/data')
        reads_tmp = output_dirs.get('reads_tmp', {}).get('value0', 'reads/tmp')
        
        if os.path.isabs(reads_tmp):
            return reads_tmp
        else:
            return os.path.join(base_dir, reads_tmp)
    except Exception as e:
        print(f"Warning: Failed to parse MinKNOW conf for tmp directory: {e}")
        return None

def main():
    parser = argparse.ArgumentParser(description="Calculate genome coverage from ONT reports and sample sheets.")
    parser.add_argument("csv_path", nargs='?', help="Path to the sample sheet CSV file (optional if --auto is used).")
    
    # Mutually exclusive group for auto-discovery vs manual JSON
    group = parser.mutually_exclusive_group()
    group.add_argument("--auto", action="store_true", help="Automatically find inputs in an ONT run directory.")
    group.add_argument("--json", help="Path to the sequencing report JSON file.")
    
    parser.add_argument("--quick", action="store_true", help="Use simplified JSON report coverage instead of full sequencing summary (when using --auto).")
    parser.add_argument("--summary", help="Path to the sequencing summary TXT file.")
    parser.add_argument("--below", type=int, help="Only output lines where coverage is below this value.")
    parser.add_argument("--bin-threshold", type=int, default=7000, help="Read length threshold for binned stats (default: 7000).")
    parser.add_argument("--no-low-material", action="store_true", help="Exclude samples marked as low material in the sample sheet.")
    parser.add_argument("--csv", action="store_true", help="Output in CSV format.")
    
    args = parser.parse_args()
    
    if args.auto:
        try:
            csv_path, summary_path, json_path = find_coverage_inputs(".", quick=args.quick)
            args.csv_path = csv_path
            args.summary = summary_path
            args.json = json_path
        except Exception as e:
            print(f"Error during auto-discovery: {e}")
            sys.exit(1)
    elif not args.csv_path:
        parser.error("The following arguments are required: csv_path (unless --auto is used)")
    
    if not os.path.exists(args.csv_path):
        print(f"Error: CSV file not found: {args.csv_path}")
        sys.exit(1)
    
    run_coverage_analysis(
        args.csv_path, 
        json_path=args.json, 
        summary_path=args.summary, 
        filter_below_coverage=args.below, 
        output_csv=args.csv, 
        bin_threshold=args.bin_threshold,
        no_low_material=args.no_low_material
    )

if __name__ == "__main__":
    main()
